! Chemical activation H + C2H2 -> C2H3* -> C2H3 (stabilization) or back to H + C2H2.
! Input deck in the MESS input format, read by MarXus (examples/chemical_activation_from_deck.rs).
! Data of the former single-well C2H3 example (geometries, frequencies, energies, collision model);
! energies in kcal/mol relative to H + C2H2. Tunneling is not included.
TemperatureList[K]                  1000.
PressureList[atm]                   0.1  1.0  10.0
EnergyStepOverTemperature           0.1
ModelEnergyLimit[kcal/mol]          400
Reactant                            P1
Model
  EnergyRelaxation
    Exponential
      Factor[1/cm]                  200
      Power                         .85
      ExponentCutoff                15
    End
  CollisionFrequency
    LennardJones
      Epsilons[1/cm]                6.95   292.0
      Sigmas[angstrom]              2.55   4.36
      Masses[amu]                   4.0    75.0
    End
  Well W1                           ! C2H3
    Species
      RRHO
        Geometry[angstrom]          5
        C   0.0   0.0229607853  -0.6194779279
        C   0.0  -0.0846208019   0.6897727967
        H   0.0   0.9977802761  -1.1068370147
        H   0.0  -0.8465433753  -1.2673164024
        H   0.0   0.5835275291   1.5364927734
        Core RigidRotor
          SymmetryFactor            1
        End
        Frequencies[1/cm]           9
        722.40  810.05  914.06  1067.96  1392.07  1616.66  3073.17  3179.01  3249.24
        ZeroEnergy[kcal/mol]        -34.44
        ElectronicLevels[1/cm]      1
          0  2
      End
    End
  Barrier B1 W1 P1                  ! C2H3 = C2H2 + H
    RRHO
      Geometry[angstrom]            5
      C   0.0   0.1183768384  -0.5562510626
      C   0.0  -0.0058980147   0.6558697182
      H   0.0   0.5386263624  -1.5351015600
      H   0.0  -0.2821730201   1.6836028161
      H   0.0  -1.5967941880  -1.3355954010
      Core RigidRotor
        SymmetryFactor              1
      End
      Frequencies[1/cm]             8
      426.55  601.17  623.87  745.02  848.44  1924.52  3392.98  3472.32
      ZeroEnergy[kcal/mol]          4.42
      ElectronicLevels[1/cm]        1
        0  2
    End
  Bimolecular P1                    ! C2H2 + H
    Fragment C2H2
      RRHO
        Geometry[angstrom]          4
        C   0.0   0.0  -0.6015
        C   0.0   0.0   0.6015
        H   0.0   0.0  -1.6635
        H   0.0   0.0   1.6635
        Core RigidRotor
          SymmetryFactor            2
        End
        Frequencies[1/cm]           7
        595.45  595.45  746.55  746.55  2004.77  3409.28  3501.09
        ZeroEnergy[1/cm]            0
        ElectronicLevels[1/cm]      1
          0  1
      End
    Fragment H
      RRHO
        Geometry[angstrom]          1
        H   0.0   0.0   0.0
        Core RigidRotor
          SymmetryFactor            1
        End
        Frequencies[1/cm]           0
        ZeroEnergy[1/cm]            0
        ElectronicLevels[1/cm]      1
          0  2
      End
    GroundEnergy[kcal/mol]          0.0
  End
End
